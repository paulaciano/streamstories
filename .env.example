# Environment variables used outside local development (./mvnw spring-boot:run needs none of them).
# Set them in the deployment environment. To try them locally, copy this file to .env (never committed),
# fill in real values and export them before starting the application: set -a; source .env; set +a

# Database connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/streamstories
SPRING_DATASOURCE_USERNAME=streamstories
SPRING_DATASOURCE_PASSWORD=change-me

# Active profile (enables structured JSON logs)
SPRING_PROFILES_ACTIVE=prod

# JWT signing key (HS256): a random value of at least 32 characters.
# For example: openssl rand -base64 48
STREAMSTORIES_SECURITY_JWT_SECRET=change-me

# Initial administrator, created on startup only if no administrator exists yet
STREAMSTORIES_ADMIN_EMAIL=admin@example.com
STREAMSTORIES_ADMIN_PASSWORD=change-me
# Optional, defaults to "Administrador"
# STREAMSTORIES_ADMIN_DISPLAYNAME=Administrador
